---
<div id="control-pills-container" class="hidden bg-white border border-slate-200 rounded-xl p-4 shadow-sm space-y-2.5">
  <div class="flex items-center justify-between">
    <span 
      class="text-sm font-semibold uppercase tracking-wider text-slate-600"
      data-en="Discovered Legal Sections"
      data-es="Secciones Legales Detectadas"
    >
      Discovered Legal Sections
    </span>
    <span 
      class="text-xs font-mono bg-indigo-50 text-indigo-700 font-semibold px-2.5 py-0.5 rounded-full border border-indigo-100"
      data-en="CLICK TO FILTER"
      data-es="CLIC PARA FILTRAR"
    >
      CLICK TO FILTER
    </span>
  </div>
  <div id="control-pills-wrapper" class="flex flex-wrap gap-2 pt-1"></div>
</div>

<script>
  const container = document.getElementById('control-pills-container');
  const wrapper = document.getElementById('control-pills-wrapper');

  window.addEventListener('document-processed', (e: any) => {
    if (!container || !wrapper) return;
    const sections = e.detail?.sections || [];
    if (!sections.length) return;

    container.classList.remove('hidden');
    wrapper.innerHTML = '';

    sections.forEach((section: string) => {
      const pill = document.createElement('button');
      pill.className = "px-3.5 py-1.5 text-sm font-medium rounded-lg bg-slate-100 border border-slate-200 text-slate-700 hover:bg-indigo-50 hover:text-indigo-700 hover:border-indigo-200 transition-all cursor-pointer shadow-2xs";
      pill.innerText = section;
      pill.onclick = () => {
        const userInput = document.getElementById('user-input') as HTMLInputElement;
        const currentLang = localStorage.getItem('app-lang') || 'en';
        if (userInput) {
          userInput.value = currentLang === 'es'
            ? `Analizar sección [${section}] para riesgos y obligaciones de cumplimiento: `
            : `Analyze section [${section}] for risks and compliance obligations: `;
          userInput.focus();
        }
      };
      wrapper.appendChild(pill);
    });
  });
</script>
