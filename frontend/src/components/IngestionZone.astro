---
---
<div class="space-y-4">
  <!-- Upload Dropzone -->
  <div 
    id="drop-zone" 
    class="border-2 border-dashed border-slate-300 hover:border-indigo-500 bg-white hover:bg-indigo-50/20 rounded-xl p-6 text-center cursor-pointer transition-all duration-200 shadow-sm group relative overflow-hidden"
  >
    <input type="file" id="file-input" accept=".pdf" class="hidden" />
    
    <div class="flex flex-col items-center justify-center space-y-3">
      <div class="w-14 h-14 rounded-full bg-indigo-50 text-indigo-600 flex items-center justify-center group-hover:scale-110 transition-transform duration-200">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12" />
        </svg>
      </div>
      <div>
        <p 
          class="text-base sm:text-lg font-semibold text-slate-800 group-hover:text-indigo-600 transition-colors"
          data-en="Upload Legal Contract (.PDF)"
          data-es="Cargar Contrato Legal (.PDF)"
        >
          Upload Legal Contract (.PDF)
        </p>
        <p 
          class="text-sm text-slate-500 mt-1"
          data-en="Automatic structural validation & vector indexing"
          data-es="Validación estructural automática e indexación vectorial"
        >
          Automatic structural validation & vector indexing
        </p>
      </div>
    </div>
  </div>

  <!-- Upload Status Card -->
  <div id="upload-status" class="hidden bg-white border border-slate-200 rounded-xl p-4 space-y-3 shadow-sm">
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <span id="status-spinner" class="inline-block w-4 h-4 border-2 border-indigo-600 border-t-transparent rounded-full animate-spin"></span>
        <span 
          id="status-text" 
          class="text-sm font-semibold text-slate-700"
          data-en="Processing Document..."
          data-es="Procesando Documento..."
        >
          Processing Document...
        </span>
      </div>
      <span id="filename-badge" class="text-xs font-medium px-3 py-1 rounded-full bg-slate-100 text-slate-600 max-w-[200px] truncate"></span>
    </div>

    <!-- Progress Bar -->
    <div class="w-full bg-slate-100 h-2 overflow-hidden rounded-full">
      <div id="progress-bar" class="bg-indigo-600 h-2 rounded-full transition-all duration-300 w-1/12"></div>
    </div>

    <!-- Step Logs -->
    <div id="pipeline-logs" class="space-y-1.5 text-sm text-slate-600 max-h-36 overflow-y-auto pt-2 border-t border-slate-100 custom-scrollbar"></div>
  </div>

  <!-- Success Notification Box -->
  <div id="upload-success-box" class="hidden bg-emerald-50 border border-emerald-200 rounded-xl p-4 text-emerald-900 shadow-sm space-y-2">
    <div class="flex items-center gap-2 font-semibold text-base text-emerald-800">
      <svg class="w-5 h-5 text-emerald-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      <span data-en="Contract Verified & Indexed" data-es="Contrato Verificado e Indexado">Contract Verified & Indexed</span>
    </div>
    <p id="success-details" class="text-sm text-emerald-700 leading-relaxed"></p>
  </div>

  <!-- Rejection Alert Box -->
  <div id="upload-error-box" class="hidden bg-rose-50 border border-rose-200 rounded-xl p-4 text-rose-900 shadow-sm space-y-2">
    <div class="flex items-center gap-2 font-semibold text-base text-rose-800">
      <svg class="w-5 h-5 text-rose-600 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
      </svg>
      <span data-en="Document Rejected" data-es="Documento Rechazado">Document Rejected</span>
    </div>
    <p id="error-details" class="text-sm text-rose-700 leading-relaxed"></p>
  </div>
</div>

<script>
  const dropZone = document.getElementById('drop-zone');
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const uploadStatus = document.getElementById('upload-status');
  const statusSpinner = document.getElementById('status-spinner');
  const progressBar = document.getElementById('progress-bar');
  const statusText = document.getElementById('status-text');
  const filenameBadge = document.getElementById('filename-badge');
  const pipelineLogs = document.getElementById('pipeline-logs');
  const uploadSuccessBox = document.getElementById('upload-success-box');
  const successDetails = document.getElementById('success-details');
  const uploadErrorBox = document.getElementById('upload-error-box');
  const errorDetails = document.getElementById('error-details');

  const API_BASE_URL = import.meta.env.PUBLIC_API_URL || 'https://agentic-auditor.onrender.com';

  function logStep(message: string, isError = false) {
    const line = document.createElement('div');
    line.className = isError ? 'text-rose-600 font-medium flex items-center gap-1.5' : 'text-slate-600 flex items-center gap-1.5';
    line.innerHTML = `<span class="${isError ? 'text-rose-500' : 'text-indigo-500'} font-semibold">•</span> ${message}`;
    pipelineLogs?.appendChild(line);
    if (pipelineLogs) pipelineLogs.scrollTop = pipelineLogs.scrollHeight;
  }

  dropZone?.addEventListener('click', () => fileInput?.click());
  dropZone?.addEventListener('dragover', (e) => { 
    e.preventDefault(); 
    dropZone.classList.add('border-indigo-500', 'bg-indigo-50/40'); 
  });
  dropZone?.addEventListener('dragleave', () => { 
    dropZone.classList.remove('border-indigo-500', 'bg-indigo-50/40'); 
  });
  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-indigo-500', 'bg-indigo-50/40');
    if (e.dataTransfer?.files?.length) handleUpload(e.dataTransfer.files[0]);
  });
  fileInput?.addEventListener('change', () => { 
    if (fileInput.files?.length) handleUpload(fileInput.files[0]); 
  });

  async function handleUpload(file: File) {
    if (!file.name.toLowerCase().endsWith('.pdf')) { 
      const currentLang = localStorage.getItem('app-lang') || 'en';
      alert(currentLang === 'es' ? 'El archivo seleccionado debe ser un contrato PDF válido.' : 'Selected file must be a valid PDF contract.');
      return; 
    }

    const currentLang = localStorage.getItem('app-lang') || 'en';

    uploadSuccessBox?.classList.add('hidden');
    uploadErrorBox?.classList.add('hidden');
    uploadStatus?.classList.remove('hidden');
    if (statusSpinner) statusSpinner.classList.remove('hidden');
    if (filenameBadge) filenameBadge.innerText = file.name;
    if (pipelineLogs) pipelineLogs.innerHTML = '';
    
    if (progressBar) {
      progressBar.classList.remove('bg-rose-500');
      progressBar.classList.add('bg-indigo-600');
      progressBar.style.width = '20%';
    }
    if (statusText) {
      statusText.innerText = currentLang === 'es' ? 'Analizando secciones legales...' : 'Parsing legal sections...';
    }
    logStep(currentLang === 'es' ? 'Extrayendo texto y estructura del PDF...' : 'Extracting PDF text layout...');

    const formData = new FormData();
    formData.append('file', file);

    try {
      if (progressBar) progressBar.style.width = '50%';
      logStep(currentLang === 'es' ? 'Evaluando límites y guardaguardas contractuales...' : 'Evaluating legal contract guardrails...');
      
      const response = await fetch(`${API_BASE_URL.replace(/\/$/, '')}/api/upload`, { 
        method: 'POST', 
        body: formData 
      });

      if (!response.ok) {
        const errorData = await response.json();
        throw new Error(errorData.detail || errorData.error || (currentLang === 'es' ? 'Ingestión de documento rechazada.' : 'Document ingestion rejected.'));
      }
      
      const data = await response.json();
      
      if (progressBar) progressBar.style.width = '85%';
      logStep(currentLang === 'es' ? 'Creando embeddings vectoriales...' : 'Creating vector embeddings...');
      logStep(currentLang === 'es' ? `Secciones detectadas: ${data.detected_sections.join(', ')}` : `Discovered sections: ${data.detected_sections.join(', ')}`);

      setTimeout(() => {
        if (progressBar) progressBar.style.width = '100%';
        if (statusText) statusText.innerText = currentLang === 'es' ? 'Ingestión Completada' : 'Ingestion Complete';
        if (statusSpinner) statusSpinner.classList.add('hidden');
        
        uploadStatus?.classList.add('hidden');
        uploadSuccessBox?.classList.remove('hidden');
        if (successDetails) {
          successDetails.innerText = currentLang === 'es' 
            ? `Archivo "${file.name}" indexado con éxito con ${data.detected_sections.length} sección(es): ${data.detected_sections.join(', ')}.`
            : `File "${file.name}" indexed successfully with ${data.detected_sections.length} section(s): ${data.detected_sections.join(', ')}.`;
        }

        window.dispatchEvent(new CustomEvent('document-processed', { 
          detail: { sections: data.detected_sections, filename: data.filename } 
        }));
      }, 400);

    } catch (error: any) {
      if (progressBar) {
        progressBar.style.width = '100%';
        progressBar.classList.remove('bg-indigo-600');
        progressBar.classList.add('bg-rose-500');
      }
      if (statusText) statusText.innerText = currentLang === 'es' ? 'Ingestión Fallida' : 'Ingestion Failed';
      if (statusSpinner) statusSpinner.classList.add('hidden');

      uploadStatus?.classList.add('hidden');
      uploadErrorBox?.classList.remove('hidden');
      if (errorDetails) {
        errorDetails.innerText = error.message || (currentLang === 'es' ? 'El archivo no superó la verificación legal estructural.' : 'File failed structural legal contract verification.');
      }
      logStep(`${error.message}`, true);
    }
  }
</script>