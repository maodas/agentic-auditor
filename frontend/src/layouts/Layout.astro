---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="bg-slate-50 text-slate-900 selection:bg-indigo-500/20 selection:text-indigo-900">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Autonomous Multi-Agent Contract Auditor — Enterprise Legal AI" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		
		<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 rx=%2224%22 fill=%22%234f46e5%22/><path d=%22M30 70 L50 30 L70 70 M38 56 L62 56%22 stroke=%22%23ffffff%22 stroke-width=%228%22 stroke-linecap=%22round%22 stroke-linejoin=%22round%22 fill=%22none%22/></svg>" />
		
		<title>{title}</title>
	</head>
	<body class="min-h-screen font-sans antialiased bg-slate-50 text-slate-900">
		<slot />
	</body>
</html>